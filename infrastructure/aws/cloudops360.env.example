# /etc/cloudops360/cloudops360.env  (owner root:cloudops, mode 0640)
# Production settings for CloudOps 360 on EC2. PLACEHOLDERS ONLY - never commit real values.
# Read by systemd (cloudops360.service). After editing: sudo systemctl restart cloudops360

FLASK_ENV=production
FLASK_APP=wsgi.py
AWS_REGION=us-east-1

# ---- Flask session key ----
# Lab 1/2: a random value generated by ec2_bootstrap.sh.
# Lab 3: delete this line and set APP_SECRET_NAME so the key comes from Secrets Manager.
SECRET_KEY=generated-by-bootstrap
# APP_SECRET_NAME=cloudops360/prod/app

# ---- Database ----
# Lab 1 (MariaDB on this instance, written by lab1_mariadb_on_ec2.sh):
# DATABASE_URL=mysql+pymysql://cloudops_user:<password>@127.0.0.1:3306/cloudops360?charset=utf8mb4
# Lab 2 (Amazon RDS, credentials in the env file):
# DATABASE_URL=mysql+pymysql://cloudops_user:<password>@<rds-endpoint>:3306/cloudops360?charset=utf8mb4
# Lab 3 (Amazon RDS, credentials in Secrets Manager via the EC2 instance role - remove DATABASE_URL):
# DB_SECRET_NAME=cloudops360/prod/db
# Verified TLS to RDS (download the bundle with lab3 steps in docs/aws_deployment.md):
# DB_SSL_CA=/etc/pki/rds/global-bundle.pem

# ---- Attachment storage ----
# Lab 1: local disk on this instance
STORAGE_BACKEND=local
UPLOAD_FOLDER=/var/lib/cloudops360/uploads
# Lab 2+: Amazon EFS (mounted by efs_mount_setup.sh)
# STORAGE_BACKEND=efs
# EFS_MOUNT_POINT=/mnt/efs
# UPLOAD_FOLDER=/mnt/efs/cloudops360-attachments

# ---- Security ----
# Nginx is the single trusted proxy in front of Gunicorn
TRUSTED_PROXY_COUNT=1
# false only while the site is served over plain HTTP (Lab 1/2); true once HTTPS is enabled (Lab 3)
SESSION_COOKIE_SECURE=false
ALLOW_SELF_REGISTRATION=false
SESSION_IDLE_TIMEOUT_MINUTES=30
LOGIN_MAX_FAILED_PER_ACCOUNT=5
