[Unit]
Description=Gunicorn instance serving CloudOps 360 Web Application
After=network.target remote-fs.target
Wants=remote-fs.target

[Service]
Type=notify
User=ec2-user
Group=ec2-user
WorkingDirectory=/var/www/cloudops-360
RuntimeDirectory=cloudops360
RuntimeDirectoryMode=0755

EnvironmentFile=/var/www/cloudops-360/.env
Environment="PATH=/var/www/cloudops-360/.venv/bin:/usr/local/bin:/usr/bin"
Environment="PYTHONUNBUFFERED=1"

ExecStart=/var/www/cloudops-360/.venv/bin/gunicorn \
    --workers 3 \
    --worker-class sync \
    --bind unix:/run/cloudops360/cloudops360.sock \
    --umask 007 \
    --timeout 120 \
    --access-logfile /var/log/cloudops360/access.log \
    --error-logfile /var/log/cloudops360/error.log \
    --capture-output \
    wsgi:app

ExecReload=/bin/kill -s HUP $MAINPID
KillMode=mixed
TimeoutStopSec=5
PrivateTmp=true
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
