# ==============================================================================
# CloudOps 360 Environment Variables Template
# Copy this file to .env for local development: `cp .env.example .env`
# NEVER COMMIT .env TO VERSION CONTROL.
# ==============================================================================

# Flask Core Configuration
FLASK_APP=run.py
FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=generate-a-strong-random-key-for-production-min-32-chars

# Database Configuration (MySQL / Amazon RDS)
# Format: mysql+pymysql://<username>:<password>@<host>:<port>/<database>
# If left commented or empty, application will default to local SQLite: sqlite:///cloudops360.db
DATABASE_URL=mysql+pymysql://cloudops_user:YourSecurePasswordHere@localhost:3306/cloudops360
# For Amazon RDS:
# DATABASE_URL=mysql+pymysql://admin:StrongPassword123@cloudops360-db.cxxxxxx.us-east-1.rds.amazonaws.com:3306/cloudops360

# Amazon EFS / Shared Attachment Storage
# In local development: leave as 'uploads' or an absolute path
# On EC2 with EFS mounted: '/mnt/efs/cloudops360-attachments'
UPLOAD_FOLDER=uploads
MAX_CONTENT_LENGTH=10485760

# AWS Integration (IAM Role is preferred on EC2; use region for SDK initialization)
AWS_REGION=us-east-1
# Set this to enable loading DB credentials and secret key dynamically from AWS Secrets Manager:
# AWS_SECRETS_NAME=cloudops360/production/db-secret

# Security Settings (Set to True behind HTTPS / Nginx TLS in Production)
SESSION_COOKIE_SECURE=False
REMEMBER_COOKIE_SECURE=False
SESSION_COOKIE_HTTPONLY=True
SESSION_COOKIE_SAMESITE=Lax
PERMANENT_SESSION_LIFETIME_MINUTES=60
