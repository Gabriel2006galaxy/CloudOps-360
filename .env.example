# ==============================================================================
# CloudOps 360 environment template - PLACEHOLDERS ONLY.
# Copy to .env (gitignored) or run scripts\setup_local_mysql.ps1 to generate one.
# NEVER commit .env or real credentials.
# ==============================================================================

# ---- Flask ----
FLASK_APP=run.py
FLASK_ENV=development
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=replace-with-a-long-random-value

# ---- Database (MySQL locally, Amazon RDS for MySQL in production) ----
# Format: mysql+pymysql://<user>:<password>@<host>:<port>/<database>?charset=utf8mb4
DATABASE_URL=mysql+pymysql://cloudops_user:CHANGE_ME@localhost:3306/cloudops360?charset=utf8mb4
# Optional: run the test-suite against MySQL (scripts\run_tests_mysql.ps1)
# MYSQL_TEST_DATABASE_URL=mysql+pymysql://cloudops_user:CHANGE_ME@localhost:3306/cloudops360_test?charset=utf8mb4
# Development only: use SQLite when DATABASE_URL is empty (default true in development)
# ALLOW_SQLITE_FALLBACK=true
# TLS to MySQL/RDS: path to the RDS CA bundle (enables certificate-verified TLS)
# DB_SSL_CA=/etc/pki/rds/global-bundle.pem

# ---- Production secrets via AWS Secrets Manager (EC2 IAM role supplies credentials) ----
# AWS_REGION=us-east-1
# Secret JSON keys: username, password, host, port, dbname
# DB_SECRET_NAME=cloudops360/prod/db
# Only needed for RDS-managed secrets that contain no host:
# DB_HOST=cloudops360-db.xxxxxxxx.us-east-1.rds.amazonaws.com
# Secret JSON: {"SECRET_KEY": "..."}
# APP_SECRET_NAME=cloudops360/prod/app

# ---- Attachment storage ----
# local = directory on this machine; efs = Amazon EFS mount (verified mounted before use)
STORAGE_BACKEND=local
UPLOAD_FOLDER=uploads
# Production: STORAGE_BACKEND=efs  UPLOAD_FOLDER=/mnt/efs/cloudops360-attachments  EFS_MOUNT_POINT=/mnt/efs
MAX_UPLOAD_BYTES=10485760

# ---- Security ----
# true in production behind HTTPS
SESSION_COOKIE_SECURE=false
SESSION_IDLE_TIMEOUT_MINUTES=30
SESSION_ABSOLUTE_TIMEOUT_HOURS=8
LOGIN_MAX_FAILED_PER_ACCOUNT=5
LOGIN_MAX_FAILED_PER_IP=20
LOGIN_LOCKOUT_WINDOW_MINUTES=15
# Number of reverse proxies in front of the app (Nginx on EC2 = 1)
TRUSTED_PROXY_COUNT=0
ALLOW_SELF_REGISTRATION=true
# Shows demo credentials on the login page (development only; forced off in production)
SHOW_DEMO_ACCOUNTS=true

# ---- Docker Compose (optional; only if you use docker compose instead of a local MySQL install) ----
# MYSQL_ROOT_PASSWORD=CHANGE_ME
# MYSQL_PASSWORD=CHANGE_ME
